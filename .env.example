# ========================================================
# 小橘 DSH 自主 Agent QQ Bot 配置文件 (.env)
# 复制本文件为 .env 并填入你的实际凭证配置
# ========================================================

# 1. 大模型 API 配置 (支持 OpenAI 协议兼容端点，如 Gemini, DeepSeek, GPT)
LLM_API_KEY=sk-your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gemini-3.8-flash-medium
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=1

# 2. QQ 与 OneBot 11 协议配置 (配合 NapCat / LLOneBot / ShamRock)
BOT_QQ=1234567890
ADMIN_QQ=987654321
ONEBOT_WS_URI=ws://127.0.0.1:3001

# 3. 多模态会话配置
MAX_IMAGES_PER_TURN=10
MAX_HISTORY_TURNS=7
SESSION_EXPIRE_SECONDS=600
GROUP_SESSION_MODE=user
GROUP_CONTEXT_LIMIT=20

# 4. 心跳保活
ENABLE_HEARTBEAT=true
HEARTBEAT_INTERVAL=300

# 4. 长回复折叠配置 (超过设定长度或行数时自动打包为一条合并转发聊天记录，防刷屏)
FORWARD_FOLD_ENABLED=true
FORWARD_FOLD_THRESHOLD=260
FORWARD_FOLD_LINES=6

# 5. 海螺 AI (MiniMax) T2A v2 语音合成配置 (前往 platform.minimaxi.com 免费领取)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here
MINIMAX_VOICE_ID=female-tianmei
MINIMAX_PITCH=2
MINIMAX_SPEED=1.08
MINIMAX_EMOTION=happy

# 6. Tavily 联网搜索密钥池 (支持逗号分隔多个 Key 自动故障转移轮换)
TAVILY_KEYS=tvly-key1,tvly-key2

# 7. 速率限制与安全防护
TAVILY_MAX_PER_MINUTE=10
TAVILY_MIN_INTERVAL=1.0
DM_LIMIT_PER_MINUTE=5
FISH_TRIGGER_PROBABILITY=0.3

# 8. 音频点歌引擎配置 (可选主音源服务端点与自定义请求凭据)
# MUSIC_SEARCH_URL=
# MUSIC_TRACK_URL=
# MUSIC_DOWNLOAD_UA=Mozilla/5.0
# MUSIC_APP_SOURCE=
